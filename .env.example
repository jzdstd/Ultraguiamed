# Configuracao do Firebase (copie os valores do Console do Firebase > Configuracoes do projeto)
# Nunca coloque valores reais aqui. No computador local use um arquivo .env (nao commitado).
# No Netlify, cadastre estas exatas variaveis em Site configuration > Environment variables.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
