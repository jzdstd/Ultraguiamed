# Configuracao do Firebase (copie os valores do Console do Firebase > Configuracoes do projeto)
# Nunca coloque valores reais aqui. No computador local use um arquivo .env (nao commitado).
# No Netlify, cadastre estas variaveis em Site configuration > Environment variables.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""

# Opcionais do Firebase (se fornecidos no seu app Web)
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""

# Lista de e-mails autorizados como administradores (separados por virgula),
# caso nao utilize a colecao Firestore "admins/{uid}" ou Custom Claims.
VITE_ADMIN_EMAILS=""
