rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('active', true) == true
        )
      );
    }

    // Cada usuário autenticado pode ler apenas seu próprio documento em admins
    // para validar permissão; gravações são bloqueadas no cliente.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Demais coleções ficam restritas a administradores explicitamente autorizados.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
